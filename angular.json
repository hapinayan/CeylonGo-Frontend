{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "cache": {
      "enabled": false
    }
  },
  "newProjectRoot": "projects",
  "projects": {
    "ceylongo": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true
                },
                "fonts": false
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "24kB",
                  "maximumError": "48kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "*.webp",
                  "input": "src/development-assets/experiences",
                  "output": "/images/experiences/"
                  },
                  {
                    "glob": "*.webp",
                    "input": "src/development-assets/rental-preview",
                    "output": "/assets/rental-preview/"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/app/experiences/services/catalog-provider.ts",
                  "with": "src/app/experiences/services/catalog-provider.development.ts"
                  },
                  {
                    "replace": "src/app/bike-rentals/rental-preview.ts",
                    "with": "src/app/bike-rentals/rental-preview.development.ts"
                  },
                  {
                    "replace": "src/app/bike-rentals/rental-booking-routes.ts",
                    "with": "src/app/bike-rentals/rental-booking-routes.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ceylongo:build:production"
            },
            "development": {
              "buildTarget": "ceylongo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
